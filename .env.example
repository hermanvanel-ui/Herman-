# ================================
# TELEGRAM CONFIGURATION
# ================================

# Option 1: Bot Token (preferred for channels where bot can be added as admin)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Option 2: User Session (fallback for private channels)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# Channel to monitor (username or ID)
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id

# Use bot (true) or user session (false)
USE_TELEGRAM_BOT=true

# ================================
# MT5 CONFIGURATION
# ================================

MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server

# Risk Management
DEFAULT_LOT_SIZE=0.01
RISK_PERCENTAGE=1.0
MAX_SLIPPAGE=10
MAGIC_NUMBER=123456

# ================================
# SYMBOL MAPPING
# ================================
# Format: SIGNAL_NAME=MT5_SYMBOL
# Example: GOLD=XAUUSD,GU=GBPUSD,EU=EURUSD

SYMBOL_MAPPING={"GOLD":"XAUUSD","GU":"GBPUSD","EU":"EURUSD","BTC":"BTCUSD","ETH":"ETHUSD"}

# ================================
# APPLICATION SETTINGS
# ================================

# Server
HOST=0.0.0.0
PORT=8000

# Mode
DRY_RUN=false
DEBUG=false

# Database
DATABASE_PATH=./data/trades.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
