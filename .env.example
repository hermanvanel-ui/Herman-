# Adaptateur email du formulaire de contact (lib/email.ts)
# Créez une clé API sur https://resend.com pour activer l'envoi réel des demandes.
# Sans cette clé, les demandes sont simplement journalisées côté serveur (aucun envoi).
RESEND_API_KEY=

# Adresse d'expédition (doit être un domaine vérifié sur Resend en production).
CONTACT_EMAIL_FROM="a.SYNC <onboarding@resend.dev>"

# Adresse de réception des demandes de devis. Par défaut : asyncagency@gmail.com
CONTACT_EMAIL_TO=asyncagency@gmail.com
